# Secrets — never commit WiFi credentials
# (bare pattern, no leading slash → matches at ANY depth:
#  firmware/secrets.py, tracker/secrets.py, ...)
secrets.py

# Python
__pycache__/
*.pyc
venv/
.venv/

# Runtime data (dashboard side)
dashboard/data/

# Claude Code local settings
.claude/settings.local.json

# OS
.DS_Store

# Blog images (large binaries)
images/

# Blog draft — stays local, not part of the published project
blogpost_fermenter_koji.md

# Third-party / personal spreadsheets kept locally (e.g. the sake calculator)
docs/*.xlsx

# Exported logs dropped in for analysis (dashboard CSV downloads)
*_log.csv
